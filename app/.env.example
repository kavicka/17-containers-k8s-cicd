# Copy to .env (git-ignored) and adjust. Never commit real keys: .env is in .gitignore.

# --- generation ---
LLM_PROVIDER=ollama              # ollama | transformers | bedrock | azure_openai | fake
LLM_MODEL=qwen3:4b               # ollama tag / HF repo id / Bedrock model id / Azure deployment name
OLLAMA_URL=http://localhost:11434

# --- retrieval ---
CHUNKING=section                 # section | fixed
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# QDRANT_URL=http://localhost:6333   # unset = embedded local Qdrant in data/qdrant
# QDRANT_API_KEY=

# --- AWS Bedrock (step 18) ---
# Credentials come from the AWS default chain: `aws sso login --profile x` + AWS_PROFILE=x. No keys here.
# AWS_PROFILE=
# AWS_REGION=eu-central-1

# --- Azure OpenAI (step 19) ---
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=          # put it in .env locally, in Key Vault / CI secrets elsewhere

# --- API ---
ALLOWED_ORIGINS=["http://localhost:5173"]
